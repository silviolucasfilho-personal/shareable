# ==========================================
# Amazon S3 / S3-Compatible Storage Config
# ==========================================

# 1. AWS Amplify / Cloudflare R2 Format (Recommended)
# (Amplify does not allow custom variables starting with "AWS_")
S3_BUCKET_NAME=my-shareable-markdown-docs
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key

# 2. Traditional AWS Credentials (also supported for local/EC2/App Runner)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# 3. Custom S3 Endpoints (Optional)
# If using MinIO, Cloudflare R2, Wasabi, or LocalStack:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

