# ==========================================
# Amazon S3 / S3-Compatible Storage Config
# ==========================================

# 1. AWS Credentials
# Required to connect to your live AWS S3 bucket:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# 2. S3 Bucket Name
S3_BUCKET_NAME=your-markdown-documents-bucket

# 3. Custom S3 Endpoints (Optional)
# If using MinIO, Cloudflare R2, Wasabi, or LocalStack:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
